{
  "name": "rebase-editor",
  "version": "2.2.1-alpha.0",
  "description": "Simple terminal based sequence editor for git interactive rebase.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/index.js', 0o755)\"",
    "test": "mocha",
    "tdd": "mocha --watch --reporter min",
    "coverage": "c8 --reporter=html --reporter=text mocha",
    "coverage-ci": "c8 --reporter=lcov --100 -- mocha --reporter min",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc",
    "ci": "concurrently --kill-others-on-failure --prefix-colors \"blue,green,yellow,magenta\" -n \"coverage,typecheck,lint,format\" \"npm run coverage-ci\" \"npm run typecheck\" \"npm run lint\" \"npm run format:check\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "node src/index.ts"
  },
  "files": [
    "dist",
    "alt-keybindings.json",
    "install-editor.sh"
  ],
  "keywords": [
    "git",
    "interactive",
    "rebase",
    "editor",
    "terminal",
    "console"
  ],
  "author": "Sjur Bakka",
  "license": "ISC",
  "dependencies": {
    "minimist": "^1.2.8",
    "terminal-kit": "^3.1.4"
  },
  "bin": {
    "rebase-editor": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/sjurba/rebase-editor.git"
  },
  "engines": {
    "node": ">=18.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^4.0.1",
    "@types/terminal-kit": "^2.5.7",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "concurrently": "^10.0.7",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "mocha": "^12.0.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
